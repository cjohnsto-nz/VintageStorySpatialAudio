<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless scene renderer: reads a JSON scenario (assets, voices, timed actions), renders it
    offline through the native engine and writes a WAV plus a metrics JSON. Used for golden
    renders, load measurements and listening tests without launching the game.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RequiresVintageStory>true</RequiresVintageStory>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/VintageStorySteamAudio/VintageStorySteamAudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="scenarios/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
