<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Diagnoses a machine and a game install without launching the game:
      - verifies every game integration point against the installed VintagestoryLib.dll,
      - loads the native engine exactly as the mod does and runs its self-test.
    Used by developers after a game update, in CI, and by players filing bug reports.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RequiresVintageStory>true</RequiresVintageStory>
    <!-- The game's assemblies are loaded from the install at runtime, never copied. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/VintageStorySpatialAudio/VintageStorySpatialAudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
