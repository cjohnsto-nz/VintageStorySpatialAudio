{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/../artifacts/native"
    },
    {
      "name": "win-x64",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 (Ninja Multi-Config)",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-x64-asan",
      "displayName": "Linux x64 with sanitizers",
      "inherits": "linux-x64",
      "cacheVariables": { "VSA_SANITIZE": "ON" }
    },
    {
      "name": "osx",
      "displayName": "macOS universal (arm64 + x86_64)",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "win-x64-debug", "configurePreset": "win-x64", "configuration": "Debug" },
    { "name": "win-x64-release", "configurePreset": "win-x64", "configuration": "Release" },
    { "name": "linux-x64-debug", "configurePreset": "linux-x64", "configuration": "Debug" },
    { "name": "linux-x64-release", "configurePreset": "linux-x64", "configuration": "Release" },
    { "name": "linux-x64-asan", "configurePreset": "linux-x64-asan", "configuration": "Debug" },
    { "name": "osx-debug", "configurePreset": "osx", "configuration": "Debug" },
    { "name": "osx-release", "configurePreset": "osx", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "win-x64-debug", "configurePreset": "win-x64", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "win-x64-release", "configurePreset": "win-x64", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "linux-x64-debug", "configurePreset": "linux-x64", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "linux-x64-release", "configurePreset": "linux-x64", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "linux-x64-asan", "configurePreset": "linux-x64-asan", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "osx-debug", "configurePreset": "osx", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "osx-release", "configurePreset": "osx", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
